---
import { SITE } from '../lib/site';
---

<section
  class="relative overflow-hidden border-b border-line/70 bg-canvas"
  aria-labelledby="hero-heading"
>
  <!-- Soft brand atmosphere -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div
      class="absolute -top-28 left-[-10%] h-[22rem] w-[22rem] rounded-full bg-brand-blue/15 blur-3xl"
    >
    </div>
    <div
      class="absolute top-10 right-[-5%] h-[26rem] w-[26rem] rounded-full bg-brand-orange/20 blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-[-20%] left-[30%] h-[18rem] w-[18rem] rounded-full bg-brand-magenta/10 blur-3xl"
    >
    </div>
  </div>

  <div
    class="container-page relative z-10 grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-2 lg:gap-12 lg:py-20"
  >
    <!-- Copy -->
    <div class="motion-safe-fade order-1 max-w-xl">
      <p
        class="text-xs font-bold tracking-[0.16em] text-brand-purple uppercase sm:text-sm"
      >
        Semrush Group Buy · BuySemrush.com
      </p>

      <h1
        id="hero-heading"
        class="mt-4 font-display text-[2rem] leading-[1.1] font-extrabold tracking-tight text-ink sm:text-4xl md:text-[2.75rem] lg:text-[3.15rem]"
      >
        Best Semrush Group Buy for SEO Tools
      </h1>

      <p class="mt-5 text-base leading-relaxed text-body sm:text-lg">
        Semrush is powerful, but expensive. Get affordable
        <strong class="font-semibold text-ink">Semrush group buy</strong> access —
        plus Ahrefs, ChatGPT, Canva, Jasper, Helium&nbsp;10 and 30+ premium tools in one
        Master Plan. Finish checkout on ToolsMandi.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <a
          href={SITE.signupUrl}
          class="inline-flex h-12 w-full items-center justify-center rounded-xl bg-brand-orange px-6 text-base font-bold text-ink shadow-[0_14px_36px_-14px_rgb(245_158_11_/_0.9)] transition-transform hover:-translate-y-0.5 sm:w-auto"
        >
          Semrush Sign Up
        </a>
        <a
          href={SITE.loginUrl}
          class="inline-flex h-12 w-full items-center justify-center rounded-xl border border-ink/10 bg-white px-6 text-base font-semibold text-ink transition-colors hover:border-brand-blue/35 sm:w-auto"
        >
          Semrush Login
        </a>
      </div>

      <p class="mt-4 text-sm text-body">
        Already a member?
        <a
          href={SITE.loginUrl}
          class="font-semibold text-brand-blue-ink underline-offset-2 hover:underline"
        >
          Login on ToolsMandi
        </a>
      </p>

      <ul
        class="mt-6 flex flex-wrap gap-2"
        aria-label="Popular search terms"
      >
        {
          [
            'semrush group buy',
            'buy semrush',
            'cheap semrush account',
            'group buy semrush',
          ].map((term) => (
            <li class="rounded-full border border-line bg-white/90 px-3 py-1 text-xs font-semibold text-ink/70">
              {term}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- SEO toolkit visual (SVG — on-brand, light for LCP) -->
    <div class="motion-safe-fade hero-visual order-2 w-full lg:justify-self-end">
      <figure class="relative mx-auto w-full max-w-[360px] sm:max-w-[420px] lg:ml-auto lg:max-w-[520px]">
        <img
          src="/images/hero-seo-dashboard.svg?v=5"
          alt="SEO toolkit: keyword research, rank tracking, and organic traffic for Semrush and Ahrefs"
          width="560"
          height="420"
          class="h-auto w-full drop-shadow-[0_24px_50px_rgba(18,20,28,0.12)]"
          fetchpriority="high"
          decoding="async"
        />
        <div
          class="pointer-events-none absolute -inset-3 -z-10 rounded-[2rem] bg-brand-gradient opacity-[0.12] blur-2xl"
          aria-hidden="true"
        >
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-visual {
      animation: hero-float 6s ease-in-out infinite;
    }
  }

  @keyframes hero-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }
</style>
