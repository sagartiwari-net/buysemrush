---
import type { FaqItem } from '../lib/faq';
import { SITE_FAQ } from '../lib/faq';

interface Props {
  items?: FaqItem[];
}

const { items = SITE_FAQ } = Astro.props;
---

<section
  id="faq"
  class="relative scroll-mt-24 border-b border-line/70 bg-paper"
  aria-labelledby="faq-heading"
>
  <div class="container-page relative py-16 sm:py-20 lg:py-24">
    <header class="mx-auto max-w-2xl text-center">
      <p
        class="text-xs font-bold tracking-[0.16em] text-brand-purple uppercase sm:text-sm"
      >
        FAQ
      </p>
      <h2
        id="faq-heading"
        class="mt-3 font-display text-3xl leading-tight font-extrabold tracking-tight text-ink sm:text-4xl"
      >
        Semrush group buy questions
      </h2>
      <p class="mt-4 text-base leading-relaxed text-body sm:text-lg">
        Access, pricing, ToolsMandi checkout, coupons, and fair-use rules — answered in plain
        language.
      </p>
    </header>

    <div
      class="mx-auto mt-10 max-w-3xl divide-y divide-line overflow-hidden rounded-2xl border border-line bg-canvas/50 shadow-[0_12px_36px_-24px_rgba(18,20,28,0.35)] sm:mt-12"
    >
      {
        items.map((item) => (
          <details class="group px-5 sm:px-6">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5 font-display text-base font-bold text-ink outline-none marker:content-none [&::-webkit-details-marker]:hidden">
              <span class="text-left">{item.question}</span>
              <span
                class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line bg-paper text-lg leading-none text-brand-purple transition group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="pb-5 pr-2 text-sm leading-relaxed text-body sm:pr-12 sm:text-base">
              {item.answer}
            </p>
          </details>
        ))
      }
    </div>
  </div>
</section>
