---
import { SITE } from '../lib/site';

const steps = [
  {
    n: '01',
    title: 'Choose your Master Plan',
    body: 'One Semrush group buy bundle — Monthly, 6 Month, or 1 Year. Semrush, Ahrefs, and 35+ SEO tools included. No per-tool checkout.',
  },
  {
    n: '02',
    title: 'Sign up on ToolsMandi',
    body: 'BuySemrush is the front door. Finish account creation and payment on ToolsMandi — secure checkout, same Master Plan access.',
    href: SITE.signupUrl,
    linkLabel: 'Create account',
  },
  {
    n: '03',
    title: 'Login and open your tools',
    body: 'Return anytime via ToolsMandi login. Launch Semrush, Ahrefs, ChatGPT, Canva, and the rest of your SEO toolkit from one place.',
    href: SITE.loginUrl,
    linkLabel: 'Go to login',
  },
] as const;
---

<section
  id="how"
  class="relative scroll-mt-24 border-b border-line/70 bg-paper"
  aria-labelledby="how-heading"
>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div
      class="absolute top-0 left-1/2 h-px w-[min(100%,42rem)] -translate-x-1/2 bg-gradient-to-r from-transparent via-brand-purple/25 to-transparent"
    >
    </div>
    <div
      class="absolute -bottom-24 right-[-8%] h-64 w-64 rounded-full bg-brand-blue/8 blur-3xl"
    >
    </div>
  </div>

  <div class="container-page relative py-16 sm:py-20 lg:py-24">
    <header class="mx-auto max-w-2xl text-center">
      <p
        class="text-xs font-bold tracking-[0.16em] text-brand-purple uppercase sm:text-sm"
      >
        Simple path to access
      </p>
      <h2
        id="how-heading"
        class="mt-3 font-display text-3xl leading-tight font-extrabold tracking-tight text-ink sm:text-4xl"
      >
        How Semrush group buy works
      </h2>
      <p class="mt-4 text-base leading-relaxed text-body sm:text-lg">
        Three steps from this page to live Semrush and Ahrefs tools — no jargon, no
        hidden tool fees.
      </p>
    </header>

    <ol
      class="how-steps relative mt-12 grid gap-10 sm:mt-14 lg:mt-16 lg:grid-cols-3 lg:gap-8"
    >
      {
        steps.map((step, i) => (
          <li class="how-step relative">
            {i < steps.length - 1 && (
              <div
                class="pointer-events-none absolute top-7 right-0 left-[4.25rem] hidden h-px bg-gradient-to-r from-brand-purple/40 via-brand-magenta/30 to-brand-orange/40 lg:block"
                aria-hidden="true"
              />
            )}

            <div class="flex flex-col items-start text-left">
              <span
                class="relative z-10 inline-flex h-14 w-14 items-center justify-center rounded-2xl bg-canvas font-display text-lg font-extrabold text-brand-purple ring-1 ring-line"
                aria-hidden="true"
              >
                {step.n}
              </span>

              <h3 class="mt-5 font-display text-xl font-bold tracking-tight text-ink">
                {step.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-body sm:text-base">
                {step.body}
              </p>

              {'href' in step && step.href && (
                <a
                  href={step.href}
                  class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-blue-ink underline-offset-2 hover:underline"
                >
                  {step.linkLabel}
                  <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 flex flex-col items-center gap-3 sm:mt-12 sm:flex-row sm:justify-center">
      <a
        href={SITE.signupUrl}
        class="inline-flex h-12 w-full items-center justify-center rounded-xl bg-brand-orange px-6 text-base font-bold text-ink shadow-[0_14px_36px_-14px_rgb(245_158_11_/_0.9)] transition-transform hover:-translate-y-0.5 sm:w-auto"
      >
        Start Semrush Sign Up
      </a>
      <a
        href="#plans"
        class="inline-flex h-12 w-full items-center justify-center rounded-xl border border-ink/10 bg-white px-6 text-base font-semibold text-ink transition-colors hover:border-brand-blue/35 sm:w-auto"
      >
        See Master Plan pricing
      </a>
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .how-step {
      animation: how-rise 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .how-step:nth-child(1) {
      animation-delay: 0.05s;
    }
    .how-step:nth-child(2) {
      animation-delay: 0.12s;
    }
    .how-step:nth-child(3) {
      animation-delay: 0.2s;
    }
  }

  @keyframes how-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
