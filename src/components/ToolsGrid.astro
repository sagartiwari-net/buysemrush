---
import { SITE } from '../lib/site';
import { TOOLS } from '../lib/content';
---

<section
  id="tools"
  class="relative scroll-mt-24 border-b border-line/70 bg-paper"
  aria-labelledby="tools-heading"
>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div
      class="absolute top-1/3 left-[-12%] h-72 w-72 rounded-full bg-brand-purple/8 blur-3xl"
    >
    </div>
    <div
      class="absolute right-[-10%] bottom-10 h-64 w-64 rounded-full bg-brand-orange/10 blur-3xl"
    >
    </div>
  </div>

  <div class="container-page relative py-16 sm:py-20 lg:py-24">
    <header class="mx-auto max-w-2xl text-center">
      <p
        class="text-xs font-bold tracking-[0.16em] text-brand-purple uppercase sm:text-sm"
      >
        {TOOLS.length}+ tools · one Master Plan
      </p>
      <h2
        id="tools-heading"
        class="mt-3 font-display text-3xl leading-tight font-extrabold tracking-tight text-ink sm:text-4xl"
      >
        Semrush, Ahrefs & SEO tools included
      </h2>
      <p class="mt-4 text-base leading-relaxed text-body sm:text-lg">
        Every Master Plan unlocks this toolkit — no separate fees per tool. Pick a plan,
        sign up on ToolsMandi, then launch Semrush group buy access and the rest from one
        login.
      </p>
    </header>

    <ul
      class="mt-12 grid grid-cols-2 gap-3 sm:mt-14 sm:grid-cols-3 sm:gap-3.5 md:grid-cols-4 lg:mt-16 lg:grid-cols-5 lg:gap-4"
      aria-label="Tools included in Master Plan"
    >
      {
        TOOLS.map((tool) => (
          <li>
            <a
              href={SITE.signupUrl}
              class="group flex h-full items-center gap-3 rounded-2xl border border-line bg-white px-3 py-3 shadow-[0_1px_0_rgb(18_20_28_/_0.03)] transition-all duration-200 hover:-translate-y-0.5 hover:border-brand-blue/30 hover:shadow-[0_14px_28px_-18px_rgb(37_99_235_/_0.45)] sm:gap-3.5 sm:px-3.5 sm:py-3.5"
              title={`Get ${tool.name} with Semrush Master Plan`}
            >
              <span
                class="inline-flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-white ring-1 ring-line sm:h-12 sm:w-12"
              >
                <img
                  src={tool.logo}
                  alt=""
                  width="48"
                  height="48"
                  class="h-full w-full object-contain p-1"
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="min-w-0 flex-1 text-left">
                <span class="line-clamp-2 text-sm font-semibold text-ink transition-colors group-hover:text-brand-blue">
                  {tool.name}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-10 flex flex-col items-center gap-3 sm:mt-12 sm:flex-row sm:justify-center">
      <a
        href={SITE.signupUrl}
        class="inline-flex h-12 w-full items-center justify-center rounded-xl bg-brand-orange px-6 text-base font-bold text-ink shadow-[0_14px_36px_-14px_rgb(245_158_11_/_0.9)] transition-transform hover:-translate-y-0.5 sm:w-auto"
      >
        Unlock all tools
      </a>
      <a
        href="#plans"
        class="inline-flex h-12 w-full items-center justify-center rounded-xl border border-ink/10 bg-white px-6 text-base font-semibold text-ink transition-colors hover:border-brand-blue/35 sm:w-auto"
      >
        View Master Plan pricing
      </a>
    </div>
  </div>
</section>
