---
import { SITE } from '../lib/site';

const explore = [
  { href: '#how', label: 'How it works' },
  { href: '#plans', label: 'Master Plan' },
  { href: '#tools', label: 'Tools' },
  { href: '#find', label: 'How to find us' },
  { href: '#faq', label: 'FAQ' },
] as const;

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-line bg-canvas">
  <div class="container-page py-14 sm:py-16">
    <div class="grid gap-10 md:grid-cols-[1.35fr_1fr_1fr] md:gap-12">
      <div>
        <a href="/" class="inline-flex items-center" aria-label={`${SITE.name} home`}>
          <img
            src="/BuySemrushLogo.svg"
            alt={SITE.name}
            width="160"
            height="36"
            class="h-9 w-auto"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-body">
          Affordable Semrush group buy access for SEO freelancers, agencies, and teams — plus
          Ahrefs and 35+ tools in one Master Plan via ToolsMandi.
        </p>
      </div>

      <div>
        <p
          class="text-xs font-bold tracking-[0.14em] text-brand-purple uppercase"
        >
          Explore
        </p>
        <ul class="mt-4 space-y-2.5">
          {
            explore.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm font-medium text-body transition-colors hover:text-ink"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p
          class="text-xs font-bold tracking-[0.14em] text-brand-purple uppercase"
        >
          Get started
        </p>
        <ul class="mt-4 space-y-2.5 text-sm font-medium text-body">
          <li>
            <a
              href={SITE.signupUrl}
              class="transition-colors hover:text-ink"
              rel="noopener noreferrer"
            >
              Sign up on ToolsMandi
            </a>
          </li>
          <li>
            <a
              href={SITE.loginUrl}
              class="transition-colors hover:text-ink"
              rel="noopener noreferrer"
            >
              Login
            </a>
          </li>
          <li>
            <a href="#plans" class="transition-colors hover:text-ink">Pricing</a>
          </li>
          <li>
            <a href="#get-access" class="transition-colors hover:text-ink">Get access</a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t border-line pt-6 text-xs text-body md:flex-row md:items-center md:justify-between"
    >
      <p>&copy; {year} {SITE.name}. All rights reserved.</p>
      <p class="flex flex-wrap gap-x-3 gap-y-1">
        <span>Independent group-buy service — not affiliated with Semrush Inc.</span>
        <a href="/sitemap-index.xml" class="hover:text-ink">Sitemap</a>
        <a href="/robots.txt" class="hover:text-ink">Robots</a>
      </p>
    </div>
  </div>
</footer>
