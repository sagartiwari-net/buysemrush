---
import { SITE } from '../lib/site';
---

<header class="sticky top-0 z-40 border-b border-line/60 bg-canvas/80 backdrop-blur-xl">
  <div class="container-page flex h-[4.25rem] items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center" aria-label={`${SITE.name} home`}>
      <img
        src="/BuySemrushLogo.svg"
        alt={SITE.name}
        width="176"
        height="40"
        class="h-10 w-auto"
        decoding="async"
      />
    </a>

    <nav
      class="hidden items-center gap-1 md:flex"
      aria-label="Page sections"
    >
      <a
        href="#how"
        class="rounded-lg px-3 py-2 text-sm font-semibold text-ink/65 transition-colors hover:text-ink"
      >
        How it works
      </a>
      <a
        href="#plans"
        class="rounded-lg px-3 py-2 text-sm font-semibold text-ink/65 transition-colors hover:text-ink"
      >
        Pricing
      </a>
      <a
        href="#tools"
        class="rounded-lg px-3 py-2 text-sm font-semibold text-ink/65 transition-colors hover:text-ink"
      >
        Tools
      </a>
      <a
        href="#find"
        class="rounded-lg px-3 py-2 text-sm font-semibold text-ink/65 transition-colors hover:text-ink"
      >
        Find us
      </a>
      <a
        href="#faq"
        class="rounded-lg px-3 py-2 text-sm font-semibold text-ink/65 transition-colors hover:text-ink"
      >
        FAQ
      </a>
    </nav>

    <nav class="flex items-center gap-2 sm:gap-3" aria-label="Account">
      <a
        href={SITE.loginUrl}
        class="rounded-lg px-3 py-2 text-sm font-semibold text-ink/65 transition-colors hover:text-ink"
      >
        Login
      </a>
      <a
        href={SITE.signupUrl}
        class="rounded-xl bg-brand-orange px-4 py-2.5 text-sm font-bold text-ink shadow-sm transition-opacity hover:opacity-90"
      >
        Get Access
      </a>
    </nav>
  </div>
</header>
